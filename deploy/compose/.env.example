# Copy to .env and fill in. See https://nickhartjes.github.io/specdeck/self-host/docker-compose/

# The signalling service's domain; apps connect to wss://<this>/signal. Point its DNS at this server.
SPECDECK_DOMAIN=specdeck.example.com

# The TURN relay's domain. Point its DNS at this server, without a proxy (TURN is UDP).
TURN_DOMAIN=turn.example.com

# This server's public IPv4 address, which coturn advertises in relayed addresses.
TURN_EXTERNAL_IP=203.0.113.10

# Shared by the signalling service and coturn. Generate one with: openssl rand -hex 32
TURN_SECRET=

# UDP relay ports. Each relayed viewer uses about two; open the whole range in the firewall.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259

# The SpecDeck release to run (the image tag), such as 1.6.0: the version you checked out.
SPECDECK_VERSION=

# Optional: relay allocations in total; keep it equal to the number of relay ports (default 100).
# TURN_TOTAL_QUOTA=100
