{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpecDeck",
  "version": "1.7.0",
  "identifier": "nl.nickhartjes.specdeck",
  "build": {
    "beforeDevCommand": "pnpm --filter @specdeck/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @specdeck/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "publisher": "SpecDeck",
    "category": "DeveloperTool",
    "shortDescription": "Run a coding agent with your team watching along",
    "longDescription": "SpecDeck runs a coding agent (Claude Code, OpenCode or omp) on your computer while teammates follow the terminal and, for Claude Code, a timeline of prompts, tool calls and file changes."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMEYwNTkwMTBCMjA0REMKUldUY0JMSVFrQVVQZnlBaEF0UEkwQzRpYXNrak8yeWhXaDB1Mk9uY0lnMUlaTVp3SmdZaVhtRjgK",
      "endpoints": [
        "https://github.com/nickhartjes/specdeck/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "specdeck"
        ]
      }
    }
  }
}
