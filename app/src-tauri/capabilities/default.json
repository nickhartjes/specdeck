{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the session windows: the first one and any opened after it. Every app command they call is granted by name (commands.txt).",
  "windows": [
    "main",
    "window-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-profile",
    "allow-set-username",
    "allow-set-notifications",
    "allow-set-viewer-notifications",
    "allow-viewer-notify",
    "allow-set-appearance",
    "allow-diagnostics-status",
    "allow-diagnostics-report-terminal",
    "allow-reconnect-viewer",
    "allow-diagnostics-export",
    "allow-diagnostics-heartbeat",
    "allow-agent-versions",
    "allow-open-install-page",
    "allow-update-status",
    "allow-restart-to-update",
    "allow-set-layout",
    "allow-set-sharing-service",
    "allow-read-join-link",
    "allow-remove-recent-folder",
    "allow-set-folder-start",
    "allow-open-sandbox-guide",
    "allow-start-hosting",
    "allow-host-attach",
    "allow-host-input",
    "allow-host-resize",
    "allow-host-set-colors",
    "allow-host-new-code",
    "allow-host-remove-viewer",
    "allow-host-set-viewer-limit",
    "allow-host-allow-suggestions",
    "allow-host-share-code",
    "allow-host-answer-suggestion",
    "allow-host-allow-files",
    "allow-host-share-file",
    "allow-host-remove-shared-file",
    "allow-host-read-shared-file",
    "allow-host-put-shared-file",
    "allow-viewer-share-file",
    "allow-host-add-to-braindump",
    "allow-host-add-note",
    "allow-host-replace-note",
    "allow-host-give-braindump",
    "allow-viewer-add-to-braindump",
    "allow-viewer-add-note",
    "allow-viewer-open-file",
    "allow-viewer-remove-file",
    "allow-save-shared-file",
    "allow-suggest-prompt",
    "allow-host-share-link",
    "allow-host-answer-link",
    "allow-host-remove-link",
    "allow-host-allow-links",
    "allow-host-ask-to-read",
    "allow-host-end-read",
    "allow-host-start-vote",
    "allow-host-cast-vote",
    "allow-host-reveal-votes",
    "allow-host-vote-again",
    "allow-host-stop-vote",
    "allow-host-keep-estimate",
    "allow-answer-read",
    "allow-cast-vote",
    "allow-send-link",
    "allow-open-shared-link",
    "allow-open-content-link",
    "allow-host-close",
    "allow-join-session",
    "allow-leave-session",
    "allow-take-join-link",
    "allow-take-start-command",
    "allow-set-session-title",
    "allow-running-sessions",
    "allow-open-running-session",
    "allow-end-running-session",
    "allow-start-screen-shown"
  ]
}
